{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Connection": {
      "HostNames": [
        "localhost"
      ],
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "docproc",
      "Password": "change-me",
      "ClientProvidedName": "document-processing-worker",
      "AutomaticRecoveryEnabled": true,
      "TopologyRecoveryEnabled": true,
      "NetworkRecoveryInterval": "00:00:10",
      "RequestedConnectionTimeout": "00:00:30",
      "RequestedHeartbeat": "00:00:30"
    },
    "Publisher": {
      "PublisherConfirmationsEnabled": true,
      "PublisherConfirmationTrackingEnabled": true,
      "Mandatory": true,
      "ConfirmationTimeout": "00:00:15",
      "DeliveryMode": 2
    },
    "Consumer": {
      "PrefetchCount": 1,
      "ConcurrentConsumerCount": 1,
      "AutoAcknowledgement": false,
      "ConsumerTagPrefix": "document-processing",
      "ShutdownTimeout": "00:00:30"
    },
    "Retry": {
      "MaximumAttempts": 4,
      "DelaySeconds": [
        10,
        60,
        300
      ],
      "PublishFailedEventWhenExhausted": true
    },
    "Topology": {
      "CommandExchange": "document.processing.commands.v1",
      "EventExchange": "document.processing.events.v1",
      "DeadLetterExchange": "document.processing.dead-letter.v1",
      "ConversionRequestQueue": "document.processing.conversion.request.v1",
      "ConversionDeadLetterQueue": "document.processing.conversion.dead.v1",
      "ConversionRequestedRoutingKey": "conversion.requested.v1",
      "ConversionCompletedRoutingKey": "conversion.completed.v1",
      "ConversionFailedRoutingKey": "conversion.failed.v1",
      "ConversionDeadLetterRoutingKey": "conversion.dead.v1",
      "RetryQueuePrefix": "document.processing.conversion.retry"
    }
  },
  "FileStorage": {
    "Aliases": {
      "local": "C:\\DocumentProcessing\\Incoming",
      "shared": "\\\\fileserver\\DocumentProcessing"
    },
    "ArtifactRoot": "C:\\DocumentProcessing\\Artifacts"
  }
}
