{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Connection": {
      "HostNames": [
        "localhost"
      ],
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "docproc",
      "Password": "change-me",
      "ClientProvidedName": "document-processing-sample-publisher",
      "AutomaticRecoveryEnabled": true,
      "TopologyRecoveryEnabled": true,
      "NetworkRecoveryInterval": "00:00:10",
      "RequestedConnectionTimeout": "00:00:30",
      "RequestedHeartbeat": "00:00:30"
    },
    "Publisher": {
      "ProducerName": "document-processing-sample-publisher",
      "ConfirmationTimeout": "00:00:15"
    },
    "Consumer": {
      "PrefetchCount": 1,
      "ConcurrentConsumerCount": 1,
      "AutoAcknowledgement": false,
      "ConsumerTagPrefix": "document-processing-sample-publisher",
      "ShutdownTimeout": "00:00:30"
    },
    "Retry": {
      "MaximumAttempts": 4,
      "DelaySeconds": [
        10,
        60,
        300
      ],
      "PublishFailedEventWhenExhausted": true
    },
    "Topology": {
      "CommandExchange": "document-processing.commands",
      "EventExchange": "document-processing.events",
      "RetryExchange": "document-processing.retry",
      "DeadLetterExchange": "document-processing.dead-letter",

      "ConversionRequestQueue": "document-processing.conversion.requests",
      "ConversionDeadLetterQueue": "document-processing.conversion.dead-letter",

      "ConversionRequestedRoutingKey": "document-processing.conversion-requested",
      "ConversionCompletedRoutingKey": "document-processing.conversion-completed",
      "ConversionFailedRoutingKey": "document-processing.conversion-failed",
      "ConversionDeadLetterRoutingKey": "document-processing.conversion-dead-letter",

      "RetryQueuePrefix": "document-processing.conversion.retry",
      "RetryRoutingKeyPrefix": "document-processing.conversion.retry",

      "QueueType": "Classic"
    }
  }
}